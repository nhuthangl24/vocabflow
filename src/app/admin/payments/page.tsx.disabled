import { createAdminClient } from "@/lib/supabase/admin";
import { DashboardClient } from "./DashboardClient";

export const revalidate = 0; 

export default async function AdminPaymentsDashboardPage() {
  const supabase = createAdminClient();

  // Fetch all orders to calculate stats locally (safe for small-medium scale)
  const { data: orders, error } = await supabase
    .from('orders')
    .select('id, amount, status, plan_id, created_at, paid_at');

  if (error) {
    console.error("Error fetching orders for dashboard:", error);
  }

  const allOrders = orders || [];
  
  // Calculate stats
  const now = new Date();
  const today = new Date(now.getFullYear(), now.getMonth(), now.getDate());
  
  const todayOrders = allOrders.filter(o => new Date(o.created_at) >= today);
  const approvedOrders = allOrders.filter(o => o.status === 'approved');
  const todayApprovedOrders = todayOrders.filter(o => o.status === 'approved');
  const pendingOrders = allOrders.filter(o => o.status === 'pending');
  const refundedOrders = allOrders.filter(o => o.status === 'refunded');

  const totalRevenue = approvedOrders.reduce((sum, o) => sum + Number(o.amount), 0);
  const todayRevenue = todayApprovedOrders.reduce((sum, o) => sum + Number(o.amount), 0);
  const pendingRevenue = pendingOrders.reduce((sum, o) => sum + Number(o.amount), 0);
  const refundedRevenue = refundedOrders.reduce((sum, o) => sum + Number(o.amount), 0);

  // Group by day for the chart (last 7 days)
  const chartData = [];
  for (let i = 6; i >= 0; i--) {
    const d = new Date(today);
    d.setDate(d.getDate() - i);
    const dateStr = d.toLocaleDateString('vi-VN', { month: '2-digit', day: '2-digit' });
    
    const dayOrders = allOrders.filter(o => {
      const oDate = new Date(o.created_at);
      return oDate.getDate() === d.getDate() && oDate.getMonth() === d.getMonth();
    });
    
    const dayRevenue = dayOrders.filter(o => o.status === 'approved').reduce((sum, o) => sum + Number(o.amount), 0);
    
    chartData.push({
      date: dateStr,
      revenue: dayRevenue,
      orders: dayOrders.length
    });
  }

  const stats = {
    totalOrders: allOrders.length,
    todayOrders: todayOrders.length,
    totalRevenue,
    todayRevenue,
    pendingOrdersCount: pendingOrders.length,
    pendingRevenue,
    refundedRevenue,
    totalProUsers: approvedOrders.length, // approximation
    chartData
  };

  return (
    <div className="w-full animate-in fade-in duration-500">
      <DashboardClient stats={stats} />
    </div>
  );
}
